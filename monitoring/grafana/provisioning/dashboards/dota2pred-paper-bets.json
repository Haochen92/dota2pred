      "type": "stat",
      "title": "Settled PnL (Kelly)",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "mappings": [],
