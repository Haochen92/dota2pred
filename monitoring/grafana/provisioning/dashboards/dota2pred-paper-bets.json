    {
      "type": "stat",
      "title": "Model Brier (lower=better)",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(power(p.prediction_probability - (CASE WHEN o.radiant_win THEN 1 ELSE 0 END), 2)) AS brier FROM match_predictions p JOIN match_outcomes o ON o.match_id = p.match_id WHERE p.prediction_probability IS NOT NULL",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cumulative PnL: Kelly vs flat baseline (settled, by match start)",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "description": "Compounding fractional-Kelly bankroll vs a fixed 1%-of-starting-bankroll flat stake per bet, over settled bets. Flat is the does-edge-weighting-beat-naive-staking baseline.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Flat baseline" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT m.start_time AS \"time\", sum(pb.pnl) OVER (ORDER BY m.start_time) AS \"Kelly\", sum(pb.flat_pnl) OVER (ORDER BY m.start_time) AS \"Flat baseline\" FROM match_paper_bets pb JOIN matches m ON m.match_id = pb.match_id WHERE pb.pnl IS NOT NULL ORDER BY m.start_time"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent paper bets",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "pnl" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "green", "value": 0 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT m.start_time, pb.match_id, pb.bet_side, round(pb.entry_price::numeric, 3) AS entry, round(pb.edge::numeric, 3) AS edge, pb.winner, round(pb.pnl::numeric, 2) AS pnl FROM match_paper_bets pb JOIN matches m ON m.match_id = pb.match_id WHERE pb.bet_side IS NOT NULL ORDER BY m.start_time DESC LIMIT 50"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg edge at entry (best side, real books)",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "description": "Mean of the larger of (model_p - radiant ask) and (1-model_p - dire ask), over captured matches with a REAL two-sided book only (both asks in 0.02-0.98 and >= $500 liquidity each side). Empty/one-sided books -- where a phantom 0.001 ask manufactures a huge fake edge -- are excluded so the number reflects genuinely tradeable value. >0 = model beats the price.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(greatest(p.prediction_probability - s.a_best_ask, (1 - p.prediction_probability) - s.b_best_ask)) AS avg_edge FROM match_odds_snapshots s JOIN match_predictions p ON p.match_id = s.match_id WHERE s.snapshot_kind = 'entry' AND s.skip_reason IS NULL AND s.a_best_ask BETWEEN 0.02 AND 0.98 AND s.b_best_ask BETWEEN 0.02 AND 0.98 AND s.a_liquidity >= 500 AND s.b_liquidity >= 500 AND p.prediction_probability IS NOT NULL",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "% real-book matches with edge > tau (0.03)",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "description": "Share of captured matches with a real two-sided book whose best-side edge clears tau, i.e. how often a genuinely bettable edge exists. Empty/one-sided books are excluded.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
