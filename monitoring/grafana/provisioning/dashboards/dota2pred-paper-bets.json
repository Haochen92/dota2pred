          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg((greatest(p.prediction_probability - s.a_best_ask, (1 - p.prediction_probability) - s.b_best_ask) > 0.03)::int) AS pct_bettable FROM match_odds_snapshots s JOIN match_predictions p ON p.match_id = s.match_id WHERE s.snapshot_kind = 'entry' AND s.skip_reason IS NULL AND s.a_best_ask BETWEEN 0.02 AND 0.98 AND s.b_best_ask BETWEEN 0.02 AND 0.98 AND s.a_liquidity >= 500 AND s.b_liquidity >= 500 AND p.prediction_probability IS NOT NULL",
          "refId": "A"
        }
      ]
    },
    {
      "type": "histogram",
      "title": "Edge-at-entry distribution (best side, real two-sided books)",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "description": "Distribution of best-side edge across captured matches with a real two-sided book (both asks in 0.02-0.98, >= $500 liquidity each side). Empty/one-sided books are excluded -- they manufacture phantom edges off a 0.001 ask. Mass right of 0 = the model beats the price.",
      "gridPos": {
