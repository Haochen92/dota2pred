      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT greatest(p.prediction_probability - s.a_best_ask, (1 - p.prediction_probability) - s.b_best_ask) AS edge FROM match_odds_snapshots s JOIN match_predictions p ON p.match_id = s.match_id WHERE s.snapshot_kind = 'entry' AND s.skip_reason IS NULL AND s.a_best_ask BETWEEN 0.02 AND 0.98 AND s.b_best_ask BETWEEN 0.02 AND 0.98 AND s.a_liquidity >= 500 AND s.b_liquidity >= 500 AND p.prediction_probability IS NOT NULL"
        }
      ]
    }
  ]
