        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(pnl) AS pnl FROM match_paper_bets WHERE pnl IS NOT NULL",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Hit rate",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg((winner = bet_side)::int) AS hit_rate FROM match_paper_bets WHERE bet_side IS NOT NULL AND winner IS NOT NULL",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Bets placed",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS bets FROM match_paper_bets WHERE bet_side IS NOT NULL",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Model Brier (lower=better)",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(power(p.prediction_probability - (CASE WHEN o.radiant_win THEN 1 ELSE 0 END), 2)) AS brier FROM match_predictions p JOIN match_outcomes o ON o.match_id = p.match_id WHERE p.prediction_probability IS NOT NULL",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cumulative PnL (settled, by match start)",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT m.start_time AS \"time\", sum(pb.pnl) OVER (ORDER BY m.start_time) AS cumulative_pnl FROM match_paper_bets pb JOIN matches m ON m.match_id = pb.match_id WHERE pb.pnl IS NOT NULL ORDER BY m.start_time"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent paper bets",
      "datasource": {
        "type": "postgres",
        "uid": "dota_postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dota_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT m.start_time, pb.match_id, pb.bet_side, round(pb.entry_price::numeric, 3) AS entry, round(pb.edge::numeric, 3) AS edge, pb.winner, round(pb.pnl::numeric, 2) AS pnl FROM match_paper_bets pb JOIN matches m ON m.match_id = pb.match_id WHERE pb.bet_side IS NOT NULL ORDER BY m.start_time DESC LIMIT 50"
        }
      ]
    }
  ]
}
